<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="CourseController"
            prefWidth="1050"
            prefHeight="680">

    <top>
        <VBox spacing="8">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="15"
                        left="25"/>
            </padding>

            <Label text="Course Management"
                   styleClass="section-title"/>

            <Label text="Add, update, search and manage courses."
                   styleClass="app-subtitle"/>

        </VBox>
    </top>

    <left>
        <VBox spacing="14"
              prefWidth="360">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="25"/>
            </padding>

            <Label text="Course Details"
                   styleClass="form-title"/>

            <GridPane hgap="10"
                      vgap="12">

                <Label text="Course Code:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="courseCodeField"
                           promptText="JAVA101"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="Course Name:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="courseNameField"
                           promptText="Java Programming"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Description:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="descriptionField"
                           promptText="Course description"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Credits:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextField fx:id="creditsField"
                           promptText="16"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

                <Label text="Lecturer:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="4"/>

                <TextField fx:id="lecturerField"
                           promptText="Dr. Dube"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="4"/>

                <Label text="Max Students:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="5"/>

                <TextField fx:id="maxStudentsField"
                           promptText="30"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="5"/>

            </GridPane>

            <Button text="Add Course"
                    onAction="#addCourse"
                    maxWidth="Infinity"/>

            <Button text="Update Course"
                    onAction="#updateCourse"
                    maxWidth="Infinity"/>

            <Button text="Delete Course"
                    onAction="#deleteCourse"
                    maxWidth="Infinity"/>

            <Button text="Clear Form"
                    onAction="#clearFields"
                    maxWidth="Infinity"/>

        </VBox>
    </left>

    <center>
        <VBox spacing="15">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="20"/>
            </padding>

            <HBox spacing="10">

                <TextField fx:id="searchField"
                           promptText="Search by course code or name"
                           prefWidth="320"/>

                <Button text="Search"
                        onAction="#searchCourses"/>

                <Button text="Clear Search"
                        onAction="#clearSearch"/>

            </HBox>

            <TableView fx:id="courseTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="courseCodeColumn"
                                 text="Code"
                                 prefWidth="100"/>

                    <TableColumn fx:id="courseNameColumn"
                                 text="Course Name"
                                 prefWidth="220"/>

                    <TableColumn fx:id="lecturerColumn"
                                 text="Lecturer"
                                 prefWidth="180"/>

                    <TableColumn fx:id="creditsColumn"
                                 text="Credits"
                                 prefWidth="90"/>

                    <TableColumn fx:id="capacityColumn"
                                 text="Capacity"
                                 prefWidth="100"/>

                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>