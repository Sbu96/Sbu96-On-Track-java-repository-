<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ReportsController"
            prefWidth="1100"
            prefHeight="700">

    <top>
        <VBox spacing="8">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="15"
                        left="25"/>
            </padding>

            <Label text="Reports"
                   styleClass="section-title"/>

            <Label text="Generate student, course, enrollment and system reports."
                   styleClass="app-subtitle"/>

        </VBox>
    </top>

    <left>
        <VBox spacing="15"
              prefWidth="330">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="25"/>
            </padding>

            <Label text="Report Options"
                   styleClass="form-title"/>

            <Button text="System Summary"
                    onAction="#generateSystemSummary"
                    maxWidth="Infinity"/>

            <Label text="Student Report"/>

            <ComboBox fx:id="studentComboBox"
                      promptText="Select student"
                      prefWidth="250"/>

            <Button text="Generate Student Report"
                    onAction="#generateStudentReport"
                    maxWidth="Infinity"/>

            <Label text="Course Report"/>

            <ComboBox fx:id="courseComboBox"
                      promptText="Select course"
                      prefWidth="250"/>

            <Button text="Generate Course Report"
                    onAction="#generateCourseReport"
                    maxWidth="Infinity"/>

            <Button text="Enrollment Report"
                    onAction="#generateEnrollmentReport"
                    maxWidth="Infinity"/>

            <Button text="Refresh Data"
                    onAction="#refreshData"
                    maxWidth="Infinity"/>

            <Button text="Clear Report"
                    onAction="#clearReport"
                    maxWidth="Infinity"/>

        </VBox>
    </left>

    <center>
        <VBox spacing="15">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="20"/>
            </padding>

            <Label text="Report Output"
                   styleClass="form-title"/>

            <TextArea fx:id="reportArea"
                      editable="false"
                      wrapText="false"
                      VBox.vgrow="ALWAYS"/>

        </VBox>
    </center>

</BorderPane>