<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="StudentController"
            prefWidth="1000"
            prefHeight="650">

    <!-- ========================= -->
    <!-- Top Section -->
    <!-- ========================= -->

    <top>

        <VBox spacing="10">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="15"
                        left="25"/>
            </padding>

            <Label text="Student Management"
                   styleClass="section-title"/>

            <Label text="Add, update, search and manage student records."
                   styleClass="app-subtitle"/>

        </VBox>

    </top>

    <!-- ========================= -->
    <!-- Left Form -->
    <!-- ========================= -->

    <left>

        <VBox spacing="15"
              prefWidth="320">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="25"/>
            </padding>

            <Label text="Student Details"
                   styleClass="form-title"/>

            <GridPane hgap="10"
                      vgap="12">

                <Label text="Student ID:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <TextField fx:id="studentIDField"
                           promptText="ST001"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="0"/>

                <Label text="First Name:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <TextField fx:id="firstNameField"
                           promptText="First name"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <Label text="Last Name:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="lastNameField"
                           promptText="Last name"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Email:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <TextField fx:id="emailField"
                           promptText="student@email.com"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="3"/>

            </GridPane>

            <Button text="Add Student"
                    onAction="#addStudent"
                    maxWidth="Infinity"/>

            <Button text="Update Student"
                    onAction="#updateStudent"
                    maxWidth="Infinity"/>

            <Button text="Delete Student"
                    onAction="#deleteStudent"
                    maxWidth="Infinity"/>

            <Button text="Clear Form"
                    onAction="#clearFields"
                    maxWidth="Infinity"/>

        </VBox>

    </left>

    <!-- ========================= -->
    <!-- Center Table -->
    <!-- ========================= -->

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="20"/>
            </padding>

            <HBox spacing="10">

                <TextField fx:id="searchField"
                           promptText="Search by student ID or name"
                           prefWidth="300"/>

                <Button text="Search"
                        onAction="#searchStudents"/>

                <Button text="Clear Search"
                        onAction="#clearSearch"/>

            </HBox>

            <TableView fx:id="studentTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="studentIDColumn"
                                 text="Student ID"
                                 prefWidth="120"/>

                    <TableColumn fx:id="firstNameColumn"
                                 text="First Name"
                                 prefWidth="140"/>

                    <TableColumn fx:id="lastNameColumn"
                                 text="Last Name"
                                 prefWidth="140"/>

                    <TableColumn fx:id="emailColumn"
                                 text="Email"
                                 prefWidth="220"/>

                </columns>

            </TableView>

        </VBox>

    </center>

</BorderPane>