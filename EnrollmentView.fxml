<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="EnrollmentController"
            prefWidth="1100"
            prefHeight="700">

    <top>
        <VBox spacing="8">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="15"
                        left="25"/>
            </padding>

            <Label text="Enrollment Management"
                   styleClass="section-title"/>

            <Label text="Enroll students into courses and manage enrollment records."
                   styleClass="app-subtitle"/>

        </VBox>
    </top>

    <left>
        <VBox spacing="15"
              prefWidth="360">

            <padding>
                <Insets top="20"
                        right="20"
                        bottom="20"
                        left="25"/>
            </padding>

            <Label text="Enrollment Details"
                   styleClass="form-title"/>

            <GridPane hgap="10"
                      vgap="12">

                <Label text="Student:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="0"/>

                <ComboBox fx:id="studentComboBox"
                          promptText="Select student"
                          prefWidth="200"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <Label text="Course:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="1"/>

                <ComboBox fx:id="courseComboBox"
                          promptText="Select course"
                          prefWidth="200"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="1"/>

                <Label text="Academic Year:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="2"/>

                <TextField fx:id="academicYearField"
                           promptText="2026"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="2"/>

                <Label text="Semester:"
                       GridPane.columnIndex="0"
                       GridPane.rowIndex="3"/>

                <ComboBox fx:id="semesterComboBox"
                          promptText="Select semester"
                          prefWidth="200"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>

            </GridPane>

            <Button text="Enroll Student"
                    onAction="#enrollStudent"
                    maxWidth="Infinity"/>

            <Button text="Drop Enrollment"
                    onAction="#dropEnrollment"
                    maxWidth="Infinity"/>

            <Button text="Remove Enrollment"
                    onAction="#removeEnrollment"
                    maxWidth="Infinity"/>

            <Button text="Refresh Data"
                    onAction="#refreshData"
                    maxWidth="Infinity"/>

            <Button text="Clear Form"
                    onAction="#clearForm"
                    maxWidth="Infinity"/>

        </VBox>
    </left>

    <center>
        <VBox spacing="15">

            <padding>
                <Insets top="20"
                        right="25"
                        bottom="20"
                        left="20"/>
            </padding>

            <HBox spacing="10">

                <Label text="Enrollment Records"
                       styleClass="form-title"/>

            </HBox>

            <TableView fx:id="enrollmentTable"
                       VBox.vgrow="ALWAYS">

                <columns>

                    <TableColumn fx:id="enrollmentIDColumn"
                                 text="Enrollment ID"
                                 prefWidth="120"/>

                    <TableColumn fx:id="studentColumn"
                                 text="Student"
                                 prefWidth="200"/>

                    <TableColumn fx:id="courseColumn"
                                 text="Course"
                                 prefWidth="220"/>

                    <TableColumn fx:id="academicYearColumn"
                                 text="Academic Year"
                                 prefWidth="120"/>

                    <TableColumn fx:id="semesterColumn"
                                 text="Semester"
                                 prefWidth="120"/>

                    <TableColumn fx:id="statusColumn"
                                 text="Status"
                                 prefWidth="120"/>

                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>